# Written by `neon deploy` / `neon env pull`
DATABASE_URL=            # pooled (-pooler host): app traffic
DATABASE_URL_UNPOOLED=   # direct: prisma migrate
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# App secrets (not provided by Neon)
# openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
# 32 random bytes, base64: openssl rand -base64 32
# Losing or changing this makes stored chats and keys unreadable.
ENCRYPTION_KEY=

