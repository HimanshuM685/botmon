generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Provider {
  GEMINI
  OPENAI
  GROK
  GROQ
  NIM
}

enum FactKind {
  FACT
  EVENT
  DATE
  PREFERENCE
}

enum FactSource {
  ANALYSIS
  COACH
  USER
}

enum Relation {
  CRUSH
  GIRLFRIEND
  BOYFRIEND
  PARTNER
  FAVORITE
  FRIEND
  EX
}

enum Gender {
  FEMALE
  MALE
  OTHER
}

enum ChatSource {
  WHATSAPP
  INSTAGRAM
  PASTE
}

/// Mirror of the Neon Auth user (neon_auth schema). id = Neon Auth user id.
model User {
  id              String    @id
  name            String?
  email           String    @unique
  image           String?
  defaultProvider Provider?
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?
  apiKeys         ApiKey[]
  people          Person[]
}

model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  provider  Provider
  model     String
  cipher    String
  last4     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model Person {
  id             String        @id @default(cuid())
  userId         String
  name           String
  relation       Relation
  gender         Gender        @default(FEMALE)
  notes          String?
  createdAt      DateTime      @default(now())
  /// Soft delete: hidden now, purged 30 days later (lib/purge.ts)
  deletedAt      DateTime?
  /// Set while a living-read update runs (app/api/people/[id]/model), so only one runs per person at a time
  modelLockUntil DateTime?
  /// Living-read updates in the current hour window (cost cap)
  modelRuns      Int           @default(0)
  modelRunsSince DateTime?
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  chats          ChatUpload[]
  analyses       Analysis[]
  facts          PersonFact[]
  nodes          MemoryNode[]
  edges          MemoryEdge[]
  threads        CoachThread[]

  @@index([userId])
}

model ChatUpload {
  id        String     @id @default(cuid())
  personId  String
  source    ChatSource
  cipher    String
  msgCount  Int
  firstAt   DateTime
  lastAt    DateTime
  myName    String
  theirName String
  /// ChatStats computed at upload (lib/stats.ts)
  /// null on rows uploaded before stats were stored; filled lazily by getChatStats (lib/data.ts)
  stats     Json?
  /// Uploader's Date#getTimezoneOffset(), minutes
  tzOffset  Int        @default(0)
  createdAt DateTime   @default(now())
  deletedAt DateTime?
  /// The chat this one pushed to the trash (new upload, moved here, restored): removing this one brings that one back.
  replacedId String?
  person    Person     @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
}

model Analysis {
  id          String    @id @default(cuid())
  personId    String
  provider    Provider
  model       String
  /// null while running or if the run failed; every row counts toward the hourly limit
  result      Json?
  /// Chat this read was based on and the last message it covered; the next run only sends newer messages
  chatId      String?
  throughAt   DateTime?
  /// "full" or "incremental"
  mode        String    @default("full")
  /// Fingerprint of the notes and timeline the advice was written for, and when (lib/context.ts)
  contextHash String?
  adviceAt    DateTime?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  person      Person    @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, createdAt])
}

/// Long-term memory about a person: extracted by analyses, saved by the coach, or added by the user.
model PersonFact {
  id         String       @id @default(cuid())
  personId   String
  kind       FactKind
  text       String
  happenedAt DateTime?
  source     FactSource
  analysisId String?
  /// People, places, topics and events this memory is about, normalised (lib/facts.ts normalizeEntity).
  /// Memories sharing one are connected: the memory graph.
  entities   String[]     @default([])
  /// How the person felt about it ("hurt", "excited") and how good or bad it was for them, -2..2.
  /// With the tags this is the emotion graph (lib/facts.ts emotionMap).
  feeling    String?
  valence    Int?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  deletedAt  DateTime?
  person     Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  linksFrom  MemoryLink[] @relation("from")
  linksTo    MemoryLink[] @relation("to")
  edges      MemoryEdge[]

  @@index([personId, deletedAt])
}

/// A direct link between two memories that shared entities can't express, e.g. the new memory "updates" the old one.
model MemoryLink {
  id     String     @id @default(cuid())
  fromId String
  toId   String
  /// "updates" | "caused" | "contradicts" | "partOf"
  kind   String
  from   PersonFact @relation("from", fields: [fromId], references: [id], onDelete: Cascade)
  to     PersonFact @relation("to", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, kind])
  @@index([toId])
}

/// A node of the memory graph: a person, place, thing or topic in this person's life. Two fixed ones per person,
/// key "them" and "me". Queried in memory by lib/graph.ts.
model MemoryNode {
  id        String       @id @default(cuid())
  personId  String
  /// Normalised name (lib/facts.ts normalizeEntity); what PersonFact.entities holds.
  key       String
  label     String
  /// "them" | "me" | "person" | "thing"
  kind      String       @default("thing")
  aliases   String[]     @default([])
  createdAt DateTime     @default(now())
  person    Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  edgesOut  MemoryEdge[] @relation("edgeFrom")
  edgesIn   MemoryEdge[] @relation("edgeTo")

  @@unique([personId, key])
}

/// A typed, directed edge: "them AVOIDS milk", "cheese IS_A milk product". `factId` is the memory it was learned
/// from (its evidence; a trashed memory hides its edges). IS_A / PART_OF edges are knowledge and have none.
model MemoryEdge {
  id        String      @id @default(cuid())
  personId  String
  fromId    String
  toId      String
  /// One of RELS in lib/graph.ts
  rel       String
  label     String?
  factId    String?
  createdAt DateTime    @default(now())
  person    Person      @relation(fields: [personId], references: [id], onDelete: Cascade)
  from      MemoryNode  @relation("edgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        MemoryNode  @relation("edgeTo", fields: [toId], references: [id], onDelete: Cascade)
  fact      PersonFact? @relation(fields: [factId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@index([fromId])
  @@index([toId])
  @@index([factId])
}

model CoachThread {
  id        String         @id @default(cuid())
  personId  String
  title     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?
  person    Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  messages  CoachMessage[]

  @@index([personId, deletedAt, updatedAt])
}

/// One row per UI message (AI SDK UIMessage), tool calls included in parts. Never trimmed.
model CoachMessage {
  id        String      @id
  threadId  String
  role      String
  parts     Json
  metadata  Json?
  createdAt DateTime    @default(now())
  thread    CoachThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}
