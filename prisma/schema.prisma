generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Provider {
  GEMINI
  OPENAI
  GROK
  GROQ
  NIM
}

enum FactKind {
  FACT
  EVENT
  DATE
  PREFERENCE
}

enum FactSource {
  ANALYSIS
  COACH
  USER
}

enum Relation {
  CRUSH
  GIRLFRIEND
  BOYFRIEND
  PARTNER
  FAVORITE
  FRIEND
  EX
}

enum Gender {
  FEMALE
  MALE
  OTHER
}

enum ChatSource {
  WHATSAPP
  INSTAGRAM
  PASTE
}

/// Mirror of the Neon Auth user (neon_auth schema). id = Neon Auth user id.
model User {
  id              String    @id
  name            String?
  email           String    @unique
  image           String?
  defaultProvider Provider?
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?
  apiKeys         ApiKey[]
  people          Person[]
}

model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  provider  Provider
  model     String
  cipher    String
  last4     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model Person {
  id        String        @id @default(cuid())
  userId    String
  name      String
  relation  Relation
  gender    Gender        @default(FEMALE)
  notes     String?
  createdAt DateTime      @default(now())
  /// Soft delete: hidden now, purged 30 days later (lib/purge.ts)
  deletedAt DateTime?
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  chats     ChatUpload[]
  analyses  Analysis[]
  facts     PersonFact[]
  threads   CoachThread[]

  @@index([userId])
}

model ChatUpload {
  id        String     @id @default(cuid())
  personId  String
  source    ChatSource
  cipher    String
  msgCount  Int
  firstAt   DateTime
  lastAt    DateTime
  myName    String
  theirName String
  /// ChatStats computed at upload (lib/stats.ts)
  /// null on rows uploaded before stats were stored; filled lazily by getChatStats (lib/data.ts)
  stats     Json?
  /// Uploader's Date#getTimezoneOffset(), minutes
  tzOffset  Int        @default(0)
  createdAt DateTime   @default(now())
  deletedAt DateTime?
  person    Person     @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
}

model Analysis {
  id        String    @id @default(cuid())
  personId  String
  provider  Provider
  model     String
  /// null while running or if the run failed; every row counts toward the hourly limit
  result    Json?
  /// Chat this read was based on and the last message it covered; the next run only sends newer messages
  chatId    String?
  throughAt DateTime?
  /// "full" or "incremental"
  mode      String    @default("full")
  /// Fingerprint of the notes and timeline the advice was written for, and when (lib/context.ts)
  contextHash String?
  adviceAt    DateTime?
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, createdAt])
}

/// Long-term memory about a person: extracted by analyses, saved by the coach, or added by the user.
model PersonFact {
  id         String     @id @default(cuid())
  personId   String
  kind       FactKind
  text       String
  happenedAt DateTime?
  source     FactSource
  analysisId String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?
  person     Person     @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, deletedAt])
}

model CoachThread {
  id        String         @id @default(cuid())
  personId  String
  title     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?
  person    Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  messages  CoachMessage[]

  @@index([personId, deletedAt, updatedAt])
}

/// One row per UI message (AI SDK UIMessage), tool calls included in parts. Never trimmed.
model CoachMessage {
  id        String      @id
  threadId  String
  role      String
  parts     Json
  metadata  Json?
  createdAt DateTime    @default(now())
  thread    CoachThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}
